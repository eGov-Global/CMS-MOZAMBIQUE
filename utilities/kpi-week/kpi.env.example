# Rename to kpi.env, fill in, chmod 600, keep out of git.
# Either paste a short-lived AUTH_TOKEN, or leave it empty and set the service-account
# credentials below so the script mints its own token (required for cron).
AUTH_TOKEN=
PGR_USERNAME=
PGR_PASSWORD=
# PGR_USER_TYPE=EMPLOYEE
# OAUTH_CLIENT_ID=egov-user-client
# OAUTH_CLIENT_SECRET=
MATOMO_URL=https://<matomo-host>/index.php
MATOMO_TOKEN=
MATOMO_SITE_ID=1
# BASE_URL=https://uat.falacidadao.gov.mz
# TENANT_ID=mz
# Postgres via docker exec (auth/OTP columns); unset -> those stay "-"
PG_CONTAINER=
# PG_USER=postgres
# PG_DB=postgres
# Air-gapped host (no public DNS): hit kong on the host instead of the public URL.
# BASE_URL=http://localhost:8000
# MATOMO_URL=http://localhost:8000/matomo/index.php
# HTTP_HOST_HEADER=falacidadao.gov.mz   # so kong matches the public route
# LOKI_URL=http://localhost:13100       # kong logs -> Successful Authentications (combined)
