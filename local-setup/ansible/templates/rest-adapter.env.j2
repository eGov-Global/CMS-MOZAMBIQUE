# REST adapter (backend/rest-adapter) — auto-loaded via env_file in
# docker-compose.{{ inventory_hostname }}.yml. Generated by ansible from
# inventory/host_vars/{{ inventory_hostname }}.yml. Edit the inventory, not
# this file. Anything not set here falls back to the app's own default
# (see backend/rest-adapter/app/config.py).
ADAPTER_API_KEY={{ adapter_api_key }}
PROXY_HOPS=1

# Reached through Kong on the DIGIT compose network, not the public host.
DIGIT_HOST=http://kong:8000/
USER_SERVICE_HOST=http://kong:8000/

RECEPTION_OFFICER_USERNAME={{ reception_officer_username }}
RECEPTION_OFFICER_PASSWORD={{ reception_officer_password }}
ROOT_TENANT_ID={{ rest_adapter_root_tenant_id }}
CITY_TENANT_ID={{ rest_adapter_city_tenant_id }}

# Boundary hierarchyType for the localities walk (empty = resolve dynamically).
LOCALITY_HIERARCHY_TYPE={{ rest_adapter_locality_hierarchy_type }}

# Codes are labelled from these localisation modules. The boundary walk needs
# its own module(s) beyond the app default — see MZ's rainmaker-boundary-*
# discovery in DEPLOYMENT.md before assuming the default is enough.
LOCALISATION_MODULES={{ rest_adapter_localisation_modules | default('rainmaker-pgr,common-masters,rainmaker-boundary-divisao_administrativa,rainmaker-boundary-admin1,rainmaker-boundary-admin') }}

LOG_LEVEL={{ rest_adapter_log_level | default('INFO') }}
