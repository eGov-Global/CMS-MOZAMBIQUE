# --- Adapter -----------------------------------------------------------------
ADAPTER_API_KEY=change-me
PORT=8090
# Number of reverse proxies in front. Set to 1 when behind HAProxy/nginx,
# which makes the app honour X-Forwarded-Prefix (needed to serve under a path).
PROXY_HOPS=1

# --- DIGIT hosts -------------------------------------------------------------
DIGIT_HOST=https://sandbox.digit.org/
USER_SERVICE_HOST=https://sandbox.digit.org/

# --- Reception officer (static credentials) ----------------------------------
# Authentication happens at the ROOT tenant; complaints are filed at the CITY tenant.
RECEPTION_OFFICER_USERNAME=
RECEPTION_OFFICER_PASSWORD=
ROOT_TENANT_ID=mz
CITY_TENANT_ID=mz.ige

# The OAuth client, not the officer. Decodes to "egov-user-client:".
OAUTH_BASIC_HEADER=Basic ZWdvdi11c2VyLWNsaWVudDo=

# Search at the state root: the tenant clause becomes a prefix match (mz -> mz.*).
SEARCH_TENANT_ID=mz

# WORKAROUND for the department-scope gap - see app/pgr/client.py.
# Extra officer/system uuids that may have filed for a citizen, comma separated.
EXTRA_COMPLAINT_FILERS=

# Phone identity. countryCode is the dialling prefix without '+';
# MOBILE_NUMBER_LENGTH is the national number length. Must match the chatbot's.
COUNTRY_CODE=258
MOBILE_NUMBER_LENGTH=9

# --- Complaint defaults ------------------------------------------------------
# COMPLAINT_SOURCE must appear in pgr-services' allowed.source property.
COMPLAINT_SOURCE=linhaverde
CASE_RELATED_TO=IGE
DEFAULT_CITIZEN_NAME=Citizen

# --- Master data -------------------------------------------------------------
# Codes are labelled from these localisation modules, at the root tenant.
LOCALISATION_MODULES=rainmaker-pgr,common-masters
DEFAULT_LOCALE=pt_PT

# --- Token cache -------------------------------------------------------------
TOKEN_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=20

# --- File uploads -------------------------------------------------------------
# Module tag DIGIT's file store records against each upload.
FILESTORE_MODULE=PGR

# --- Logging -------------------------------------------------------------
# JSON lines, rotated by size, written into LOG_DIR. LOG_LEVEL=DEBUG also logs
# the path/headers/payload of every request sent to PGR (app/pgr/client.py).
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# LOG_OUTPUT: console, file, or both
LOG_OUTPUT=both

